{
  "name": "rhea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @rhea/app-api dev",
    "dev:mobile": "pnpm --filter @rhea/mobile dev",
    "dev:worker:ai": "pnpm --filter @rhea/job-worker dev:ai",
    "dev:worker:domain": "pnpm --filter @rhea/job-worker dev:domain",
    "dev:worker:safety": "pnpm --filter @rhea/job-worker dev:safety",
    "infra:down": "docker compose -f infra/local/compose.yaml down",
    "infra:up": "docker compose -f infra/local/compose.yaml up -d --wait",
    "migrate": "pnpm --filter @rhea/database migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
