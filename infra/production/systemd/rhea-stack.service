[Unit]
Description=Rhea Shanghai single-active application stack
Requires=docker.service rhea-egress-firewall.service
After=docker.service rhea-egress-firewall.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rhea/infra/production
EnvironmentFile=/etc/rhea/stack.env
ExecStart=/usr/bin/docker compose up --detach --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
