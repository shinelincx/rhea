{
  "name": "@rhea/job-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:ai": "tsx src/main.ts ai",
    "dev:domain": "tsx src/main.ts domain",
    "dev:safety": "tsx src/main.ts safety",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rhea/generated-learning": "workspace:*",
    "@rhea/learning-content": "workspace:*",
    "@rhea/model-gateway-adapter": "workspace:*",
    "@rhea/postgres-generated-learning": "workspace:*",
    "@rhea/postgres-learning-content": "workspace:*",
    "@rhea/queue-adapter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
