{
  "expo": {
    "name": "Rhea 学习助手",
    "slug": "rhea-learning-assistant",
    "version": "0.1.0",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rhea 需要使用相机拍摄作业页面。",
          "microphonePermission": false,
          "photosPermission": "Rhea 只会访问你选择的作业图片。"
        }
      ]
    ],
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro"
    }
  }
}
